# Copy to .env and adjust. All values have safe defaults (see src/plugins/env.ts).

# Runtime environment: development | production | test
NODE_ENV=development

# HTTP port the server listens on.
PORT=3000

# Log verbosity: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# SQLite database location (file: URL).
DATABASE_URL=file:./data/app.db

# Optional. Enables AES-256-GCM encryption-at-rest for flagged columns.
# Must be a base64url-encoded 32-byte key. Leave empty to disable encryption.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
DB_ENCRYPTION_KEY=

# Comma-separated CORS allowlist (e.g. https://app.example.com,https://admin.example.com).
# Empty disables cross-origin requests.
CORS_ORIGIN=

# Rate limiting: max requests per window, and the window length.
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=1 minute

# Bearer token the browser extension must send. Required for /listings.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
INGEST_TOKEN=

# Trust X-Forwarded-For from a reverse proxy (Traefik), so rate limiting and logs
# see the real client IP. Empty/false (default) ignores the header, which is safe
# when the app is reachable directly. Otherwise: true (trust all hops), a hop
# count (e.g. 1), or a comma-separated list of proxy IPs/CIDRs. Only set it when
# every request really comes through the proxy; otherwise clients can spoof
# their IP and dodge the rate limit. Read from the process environment, so set it
# in the container (compose `.env`), not only in a dev .env loaded by the app.
# Invalid values stop the server at boot. Behind Docker, prefer the proxy
# network's CIDR (e.g. 172.18.0.0/16): a single container IP changes on recreate.
TRUST_PROXY=
